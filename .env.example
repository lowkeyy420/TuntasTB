# TuntasTB environment configuration.
# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored; `.env.example` is committed and must document every
# variable read by web/src/lib/config.schema.ts.

# --- Required ---

# Postgres connection string used by the web app and migrations.
# For the Docker Compose stack the web container reaches postgres by service name.
DATABASE_URL=postgres://tuntas:tuntas@postgres:5432/tuntas

# Secret used to sign nurse session JWTs. Minimum 32 characters.
# Generate with: openssl rand -base64 36
SESSION_SECRET=change-me-to-a-random-48-char-secret-xxxxxxxxxxxx

# Server-side pepper mixed into password hashing. Minimum 32 characters.
# Generate with: openssl rand -base64 36
HASH_PEPPER=change-me-to-another-random-48-char-secret-xxxxx

# Public base URL of the app. Session cookies are marked Secure when https.
APP_BASE_URL=http://localhost:3000

# --- Optional (sensible defaults shown) ---

# Base URL of the external Langflow instance. Default resolves the host from
# inside containers. Leave as-is when running Langflow on the host at :7860.
LANGFLOW_BASE_URL=http://host.docker.internal:7860

# Langflow API key. Leave EMPTY to run in rules-only mode (no LLM calls).
LANGFLOW_API_KEY=

# Timeout in milliseconds for Langflow HTTP calls. Default: 15000.
LANGFLOW_TIMEOUT_MS=15000

# Shared bearer token for internal/server-to-server API routes. Optional.
INTERNAL_API_TOKEN=

# Demo nurse credentials used by the seed command.
SEED_NURSE_EMAIL=perawat@demo.id
SEED_NURSE_PASSWORD=demo12345
